{
  "name": "position-monitor",
  "version": "1.0.0",
  "description": "Angel One SmartAPI Position Monitor Algo",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules --max-old-space-size=512 node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules --max-old-space-size=512 node_modules/jest/bin/jest.js --coverage --runInBand",
    "build": "tsc -p tsconfig.build.json",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build",
    "start": "node dist/main.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "otplib": "^13.4.1",
    "winston": "^3.19.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "~30.4.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.14",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}

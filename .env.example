# Position Monitor Environment Variables

PORT=3000
NODE_ENV=development

# Broker Credentials (Angel One SmartAPI - required for live exit-order placement)
API_KEY=
CLIENT_CODE=
CLIENT_PIN=
CLIENT_TOTP_PIN=

# Monitoring thresholds and parameters
PROFIT_TARGET_PCT=1.5
STOPLOSS_PCT=2.0
WORTHLESS_LTP_THRESHOLD=5.0
STALE_TICK_SECONDS=90
MTM_LOG_INTERVAL_MINUTES=5

# SmartAPI Tick Feeder config
FEEDER_REFRESH_TIME=09:10
FEEDER_WS_URL=wss://smartapisocket.angelone.in/smart-stream
MONITOR_WEBHOOK_URL=http://localhost:3000/webhook/ticks
SCRIP_MASTER_PATH=/home/ubuntu/niftyicifalgo/scrip_master.json

# Exit execution rate-limit & retry protection
EXIT_RETRY_COOLDOWN_MS=300000
EXIT_MAX_ATTEMPTS_PER_DAY=5
RATE_LIMIT_BACKOFF_MS=900000
